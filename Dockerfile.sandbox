FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml README.md /app/
COPY quant_platform /app/quant_platform

RUN pip install --no-cache-dir pydantic numpy pandas && \
    chmod -R a-w /app

USER 65534:65534
ENTRYPOINT ["python3", "-I", "-m", "quant_platform.strategy.sandbox_worker"]
