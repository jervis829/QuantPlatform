ARG NODE_BASE_IMAGE=public.ecr.aws/docker/library/node:22-alpine
FROM ${NODE_BASE_IMAGE}

WORKDIR /ui

COPY package.json package-lock.json ./
ARG NPM_REGISTRY=https://registry.npmjs.org
RUN npm ci --no-audit --no-fund --fetch-retries=5 --fetch-retry-mintimeout=10000 --registry=${NPM_REGISTRY} || \
    npm ci --no-audit --no-fund --fetch-retries=5 --fetch-retry-mintimeout=10000 --registry=https://registry.npmmirror.com

ARG BACKEND_INTERNAL_URL=http://api:8000
ENV BACKEND_INTERNAL_URL=${BACKEND_INTERNAL_URL}

COPY . .
RUN npm run build

EXPOSE 3000
CMD ["npm", "run", "start"]
