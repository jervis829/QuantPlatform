# ============================================================
# QuantPlatform 环境变量配置示例（复制为 .env 后按需修改）
# ============================================================

# 1. 数据库与缓存
# 本地极速模式默认使用 SQLite；生产环境推荐 PostgreSQL：
# QUANT_DATABASE_URL=postgresql+psycopg://quant:quant_secret_change_me@localhost:5432/quant_platform
QUANT_DATABASE_URL=sqlite:///./quant_platform.sqlite3
QUANT_REDIS_URL=redis://localhost:6379/0

# Docker Compose 内部 PostgreSQL 账户（供 docker-compose.yml 读取）
POSTGRES_USER=quant
POSTGRES_PASSWORD=quant_secret_change_me
POSTGRES_DB=quant_platform

# 2. RBAC 四角色 API 访问令牌（生产部署请务必替换为强随机字符串！）
QP_VIEWER_API_KEY=viewer-dev-token
QP_RESEARCHER_API_KEY=researcher-dev-token
QP_OPERATOR_API_KEY=operator-dev-token
QP_ADMIN_API_KEY=admin-dev-token

# 3. 交易所 API Key 加密主密钥（32字节 URL-safe Base64 Fernet Key）
# 生成命令: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QUANT_MASTER_ENCRYPTION_KEY=

# 4. 策略沙箱与时钟偏移安全门禁
QUANT_SANDBOX_TIMEOUT_SEC=5.0
QUANT_SANDBOX_MAX_MEMORY_MB=256
QUANT_MAX_CLOCK_SKEW_MS=1000

# 5. 自然语言生成策略（可选，未配置时自动使用内置离线确定性规则合成器）
# 支持 OpenAI / DeepSeek / 通义千问 / 本地 Ollama (如 http://localhost:11434/v1)
QUANT_LLM_API_BASE=
QUANT_LLM_API_KEY=
QUANT_LLM_MODEL=gpt-4o-mini

# 6. 前端反向代理目标（前端开发默认转发到 http://127.0.0.1:8000）
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
